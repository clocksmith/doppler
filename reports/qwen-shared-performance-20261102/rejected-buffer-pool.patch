@@ -0,0 +1,13 @@
+export interface WholeTokenReadbackLease {
+  readonly feedback: GPUBuffer;
+  readonly buffers: readonly GPUBuffer[];
+  /** After all work settles, retain unmapped slots on success; discard them on failure. */
+  release(reusable: boolean): void;
+}
+
+export declare class WholeTokenReadbackPool {
+  constructor(device: GPUDevice);
+  assertSettled(): void;
+  acquire(count: number, size: number): WholeTokenReadbackLease;
+  destroy(): void;
+}
