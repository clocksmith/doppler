+// A program reuses settled slots, grows to the largest requested batch, and never
+// hands mapped/in-flight or failed resources to another batch or cursor owner.
+{
+  const device = makeDevice(), res = makeModel(device), program = new WholeTokenProgram(device);
+  for (const pos of [10,11,12,13]) await observeStep(program, device, res, pos, 42);
+  const create = device.createBuffer, resources = [];
+  device.createBuffer = descriptor => {
+    const buffer = create(descriptor);
+    if (descriptor.label.startsWith('whole_token_batch_')) {
+      resources.push(buffer); buffer.destroyCount = 0; buffer.destroy = () => buffer.destroyCount++;
+    }
+    return buffer;
+  };
+  const first = await program.startBatch(14,7,3);
+  await assert.rejects(program.startBatch(14,7,3), /Settle the active batch/);
+  await assert.rejects(program.run(14,7), /Settle the active batch/);
+  assert.throws(() => program.resumeAfterRestore(14), /Settle the active batch/);
+  assert.throws(() => program.beginGeneration(), /Settle the active batch/);
+  assert.throws(() => program.invalidate('in flight'), /Settle the active batch/);
+  assert.equal(resources.length,4);
+  await first.settle();
+  assert.deepEqual((await program.runBatch(17,9,3)).map(row => row[0]), [17009,35009,54009]);
+  assert.equal(resources.length,4, 'an equal-size batch allocates no new slots');
+  await program.runBatch(20,11,5);
+  assert.equal(resources.length,6, 'growing by two tokens acquires two slots');
+  device.dropNextSubmit = true;
+  await assert.rejects(program.runBatch(25,1,2), /Batched token readback failed/);
+  assert.ok(resources.every(buffer => buffer.destroyCount === 1), 'failed pool is discarded after settlement');
+  program.resumeAfterRestore(25);
+  assert.deepEqual((await program.runBatch(25,13,2)).map(row => row[0]), [25013,51013]);
+  assert.equal(resources.length,9, 'failure recovery acquires fresh feedback and staging slots');
+  program.destroy(); program.destroy();
+  assert.ok(resources.every(buffer => buffer.destroyCount === 1), 'every owned slot is destroyed once');
+}
+
+// Allocation and asynchronous map failures release the complete batch lease and
