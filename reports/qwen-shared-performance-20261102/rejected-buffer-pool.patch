diff --git a/src/inference/pipelines/text/generator/whole-token-readback-pool.js b/src/inference/pipelines/text/generator/whole-token-readback-pool.js
new file mode 100644
index 000000000..bf3fce2cd
--- /dev/null
+++ b/src/inference/pipelines/text/generator/whole-token-readback-pool.js
@@ -0,0 +1,57 @@
+// Retained readback slots belong to one prepared program and its injected device.
+// The global buffer pool cannot own these mapped slots or their in-flight lease.
+export class WholeTokenReadbackPool {
+  /** @param {GPUDevice} device */
+  constructor(device) {
+    this.device = device;
+    /** @type {GPUBuffer | null} */ this.feedback = null;
+    /** @type {GPUBuffer[]} */ this.buffers = [];
+    this.active = false;
+  }
+
+  assertSettled() {
+    if (this.active) throw new Error('[WholeTokenProgram] Settle the active batch before reusing or releasing its program.');
+  }
+
+  /** Caller returns the lease only after every map and submission has settled.
+   * @param {number} count @param {number} size
+   * @returns {import('./whole-token-readback-pool.js').WholeTokenReadbackLease} */
+  acquire(count, size) {
+    this.assertSettled();
+    this.active = true;
+    try {
+      this.feedback ??= this.device.createBuffer({ label: 'whole_token_batch_feedback', size: 4,
+        usage: GPUBufferUsage.COPY_SRC | GPUBufferUsage.COPY_DST });
+      while (this.buffers.length < count) {
+        this.buffers.push(this.device.createBuffer({ label: `whole_token_batch_readback_${this.buffers.length}`, size,
+          usage: GPUBufferUsage.MAP_READ | GPUBufferUsage.COPY_DST }));
+      }
+    } catch (error) {
+      try { this.#discard(); } finally { this.active = false; }
+      throw error;
+    }
+    let released = false;
+    return {
+      feedback: this.feedback,
+      buffers: this.buffers,
+      release: (reusable) => {
+        if (released) return;
+        released = true;
+        try { if (!reusable) this.#discard(); }
+        finally { this.active = false; }
+      },
+    };
+  }
+
+  #discard() {
+    for (const buffer of this.buffers) buffer.destroy();
+    this.feedback?.destroy();
+    this.feedback = null;
+    this.buffers = [];
+  }
+
+  destroy() {
+    this.assertSettled();
+    this.#discard();
+  }
+}
