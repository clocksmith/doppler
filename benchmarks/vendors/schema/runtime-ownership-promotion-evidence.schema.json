{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/runtime-ownership-promotion-evidence-v1.schema.json",
  "title": "Doppler Runtime Ownership Promotion Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decisionId",
    "workload",
    "logicalModelId",
    "manifestVariantId",
    "resolvedArtifactVariantId",
    "resolvedExecutionId",
    "sourceProviderId",
    "sourceArtifactId",
    "sourceExecutionId",
    "incumbentProviderId",
    "incumbentArtifactId",
    "incumbentExecutionId",
    "correctnessClass",
    "harnessRevision",
    "environmentFingerprint",
    "disposition",
    "decisionRationale",
    "evidenceSetDigest",
    "hypothesisSetDigest",
    "decision",
    "authority",
    "reviewer",
    "reviewerRevision",
    "rationale",
    "promotedAtUtc",
    "qualifiedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schema": { "const": "doppler.runtime-ownership-promotion-evidence/v1" },
    "decisionId": { "$ref": "#/$defs/id" },
    "workload": { "enum": ["generation", "embedding", "reranking"] },
    "logicalModelId": { "$ref": "#/$defs/text" },
    "manifestVariantId": { "$ref": "#/$defs/text" },
    "resolvedArtifactVariantId": { "$ref": "#/$defs/sha256" },
    "resolvedExecutionId": { "$ref": "#/$defs/sha256" },
    "sourceProviderId": { "$ref": "#/$defs/text" },
    "sourceArtifactId": { "$ref": "#/$defs/text" },
    "sourceExecutionId": { "$ref": "#/$defs/sha256" },
    "incumbentProviderId": { "$ref": "#/$defs/text" },
    "incumbentArtifactId": { "$ref": "#/$defs/text" },
    "incumbentExecutionId": { "$ref": "#/$defs/sha256" },
    "correctnessClass": {
      "enum": [
        "exact-token",
        "tolerance-bounded-numerical",
        "semantic",
        "held-out-task-metric"
      ]
    },
    "harnessRevision": { "$ref": "#/$defs/revision" },
    "environmentFingerprint": { "$ref": "#/$defs/sha256" },
    "disposition": { "enum": ["incumbent", "doppler", "dual"] },
    "decisionRationale": { "$ref": "#/$defs/text" },
    "evidenceSetDigest": { "$ref": "#/$defs/sha256" },
    "hypothesisSetDigest": { "$ref": "#/$defs/sha256" },
    "decision": { "const": "promote-disposition" },
    "authority": { "const": "human" },
    "reviewer": { "$ref": "#/$defs/text" },
    "reviewerRevision": { "$ref": "#/$defs/revision" },
    "rationale": { "$ref": "#/$defs/text" },
    "promotedAtUtc": { "type": "string", "format": "date-time" },
    "qualifiedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
