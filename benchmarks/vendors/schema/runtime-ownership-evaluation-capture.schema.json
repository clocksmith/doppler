{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/runtime-ownership-evaluation-capture-v1.schema.json",
  "title": "Doppler Runtime Ownership Evaluation Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decisionId",
    "recommendedDisposition",
    "decisionRationale",
    "qualifiedAtUtc",
    "expiresAtUtc",
    "hypothesisResults",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "doppler.runtime-ownership-evaluation-capture/v1" },
    "decisionId": { "$ref": "#/$defs/id" },
    "recommendedDisposition": { "enum": ["incumbent", "doppler", "dual"] },
    "decisionRationale": { "type": "string", "minLength": 1 },
    "qualifiedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "hypothesisResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hypothesisResult" }
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    },
    "hypothesisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "passed", "observedValue", "evaluatedAtUtc", "evidencePath"],
      "properties": {
        "axis": {
          "enum": [
            "unsupported-operation",
            "end-to-end-performance",
            "memory",
            "diagnostic-depth",
            "offline-artifact-control",
            "verified-correction-path"
          ]
        },
        "passed": { "type": "boolean" },
        "observedValue": {
          "anyOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }]
        },
        "evaluatedAtUtc": { "type": "string", "format": "date-time" },
        "evidencePath": { "$ref": "#/$defs/repoPath" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceExecution",
        "incumbentExecution",
        "dopplerExecution",
        "correctness",
        "taskQuality",
        "usability",
        "memory",
        "endToEndPerformance",
        "diagnosticDepth",
        "distributionCost",
        "integrationBurden",
        "providerRisk"
      ],
      "properties": {
        "sourceExecution": { "$ref": "#/$defs/repoPath" },
        "incumbentExecution": { "$ref": "#/$defs/repoPath" },
        "dopplerExecution": { "$ref": "#/$defs/repoPath" },
        "correctness": { "$ref": "#/$defs/repoPath" },
        "taskQuality": { "$ref": "#/$defs/repoPath" },
        "usability": { "$ref": "#/$defs/repoPath" },
        "memory": { "$ref": "#/$defs/repoPath" },
        "endToEndPerformance": { "$ref": "#/$defs/repoPath" },
        "diagnosticDepth": { "$ref": "#/$defs/repoPath" },
        "distributionCost": { "$ref": "#/$defs/repoPath" },
        "integrationBurden": { "$ref": "#/$defs/repoPath" },
        "providerRisk": { "$ref": "#/$defs/repoPath" }
      }
    }
  }
}
