+var<workgroup> partial: array<vec4<f32>, WORKGROUP_SIZE * (TOP_K + 1u)>;
+@compute @workgroup_size(WORKGROUP_SIZE, 1, 1)
+fn main(@builtin(workgroup_id) group: vec3<u32>, @builtin(num_workgroups) grid: vec3<u32>,
+        @builtin(local_invocation_index) lane: u32) {
+    let tiles = (u.hidden_size + 3u) / 4u;
+    let tile = group.x + group.y * grid.x;
+    let token = tile / tiles;
+    if (token >= u.num_tokens) { return; }
+    let row = (tile % tiles) * 4u;
+    for (var slot = 0u; slot <= TOP_K; slot++) {
+        let is_shared = slot == TOP_K;
+        let width = select(u.intermediate_size, u.shared_size, is_shared);
+        var expert = 0u;
+        if (!is_shared) { expert = indices[token * TOP_K + slot]; }
+        var sums = vec4<f32>(0.0);
+        bank = select(0u, 1u, is_shared);
+        if (expert < u.num_experts) {
+            for (var b = lane / 4u; b < width / 32u; b += WORKGROUP_SIZE / 4u) {
+                for (var r = 0u; r < 4u; r++) {
+                    if (row+r < u.hidden_size) {
+                        sums[r] += quarter_term(expert*u.hidden_size+row+r, b, lane%4u, width/32u,
+                            select(ROUTED_FORMAT, SHARED_FORMAT, is_shared), select(ROUTED_BYTES, SHARED_BYTES, is_shared),
+                            (token*(TOP_K+1u)+slot)*u.slot_stride);
+                    }
+                }
+            }
+        }
+        partial[slot*WORKGROUP_SIZE+lane] = sums;
+    }
+    workgroupBarrier();
+    for (var stride = WORKGROUP_SIZE / 2u; stride > 0u; stride /= 2u) {
+        if (lane < stride) {
+            for (var slot = 0u; slot <= TOP_K; slot++) {
+                partial[slot*WORKGROUP_SIZE+lane] += partial[slot*WORKGROUP_SIZE+lane+stride];
+            }
+        }
+        workgroupBarrier();
+    }
+    if (lane < 4u && row+lane < u.hidden_size) {
+        var routed = 0.0;
+        for (var slot = 0u; slot < TOP_K; slot++) {
+            routed += route_weights[token*TOP_K+slot] * partial[slot*WORKGROUP_SIZE][lane];
+        }
+        let is_shared = clamp_product(sigmoid(scalar_gate[token]) * partial[TOP_K*WORKGROUP_SIZE][lane]);
+        output[token*u.hidden_size+row+lane] = routed + is_shared;
+    }
+}
