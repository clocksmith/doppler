+
+// One native Q5_K group of 32 values; stage four decoded values per lane.
+fn q5k_stage_four(base: u32, group: u32, quarter: u32) -> vec4<f32> {
+    var scale: u32;
+    var minimum: u32;
+    if (group < 4u) {
+        scale = q40_byte(base + 4u + group) & 63u;
+        minimum = q40_byte(base + 8u + group) & 63u;
+    } else {
+        scale = (q40_byte(base + 8u + group) & 15u) | ((q40_byte(base + group) >> 6u) << 4u);
+        minimum = (q40_byte(base + 8u + group) >> 4u) | ((q40_byte(base + 4u + group) >> 6u) << 4u);
+    }
+    let low_word = tile_word(base + 48u + (group / 2u) * 32u + quarter * 4u);
+    let high_word = tile_word(base + 16u + quarter * 4u);
+    let shifts = vec4<u32>(0u, 8u, 16u, 24u);
+    let low = ((vec4<u32>(low_word) >> shifts) >> vec4<u32>((group % 2u) * 4u)) & vec4<u32>(15u);
+    let high = (((vec4<u32>(high_word) >> shifts) >> vec4<u32>(group)) & vec4<u32>(1u)) << vec4<u32>(4u);
+    let d = packed_half(base) * f32(scale);
+    let m = packed_half(base + 2u) * f32(minimum);
+    return d * vec4<f32>(low | high) - vec4<f32>(m);
 }

