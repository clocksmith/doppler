+    partial[lane] = sum;
+    workgroupBarrier();
+    for (var stride = THREADS_PER_COL_GEMV / 2u; stride > 0u; stride /= 2u) {
+        if (thread < stride) { partial[lane] += partial[lane + stride]; }
+        workgroupBarrier();
+    }
+    if (thread == 0u && n < u.N) { output[u.c_offset + m * u.N + n] = partial[lane] * u.alpha; }
