{
  "id": "profiles/muse-glimmer-30b-source-parity",
  "name": "muse-glimmer-30b-source-parity",
  "description": "Deterministic raw-text source-parity profile for the pinned Muse Glimmer 30B checkpoint. Restricts qualification to a 256-token contiguous KV session while preserving the manifest-declared graph, dtypes, kernels, and model semantics.",
  "intent": "verify",
  "compatibleIntents": ["verify"],
  "stability": "experimental",
  "owner": "doppler-core",
  "createdAtUtc": "2026-08-23T00:00:00Z",
  "extends": "profiles/production",
  "model": "muse-glimmer-30b-text-f16-af32",
  "runtime": {
    "shared": {
      "harness": {
        "referenceTranscript": {
          "enabled": true,
          "captureLogits": true,
          "captureKvBytes": true
        }
      },
      "debug": {
        "logLevel": {
          "defaultLogLevel": "warn"
        },
        "trace": {
          "enabled": false
        },
        "profiler": {
          "enabled": false
        }
      }
    },
    "inference": {
      "prompt": "A rigorous explanation of why local GPU execution receipts matter begins with",
      "chatTemplate": {
        "enabled": false,
        "type": null,
        "thinking": false
      },
      "generation": {
        "maxTokens": 128,
        "disableMultiTokenDecode": true
      },
      "batching": {
        "maxTokens": 128,
        "batchSize": 1,
        "readbackInterval": 1,
        "stopCheckMode": "per-token",
        "readbackMode": "sequential",
        "ringTokens": 1,
        "ringStop": 1,
        "ringStaging": 1
      },
      "sampling": {
        "temperature": 0,
        "topK": 1,
        "topP": 1,
        "repetitionPenalty": 1,
        "repetitionPenaltyWindow": 1,
        "greedyThreshold": 0,
        "suppressSpecialTokens": false,
        "suppressSpecialLikeTokens": false,
        "suppressTokenIds": []
      },
      "kvcache": {
        "maxSeqLen": 256,
        "layout": "contiguous",
        "kvDtype": "f16",
        "pageSize": 256,
        "tiering": {
          "mode": "off"
        }
      },
      "session": {
        "kvcache": {
          "maxSeqLen": 256,
          "layout": "contiguous",
          "kvDtype": "f16",
          "pageSize": 256,
          "tiering": {
            "mode": "off"
          },
          "quantization": {
            "mode": "none",
            "bitWidth": 4,
            "prodMode": false
          }
        },
        "decodeLoop": {
          "batchSize": 1,
          "readbackInterval": 1,
          "stopCheckMode": "per-token",
          "readbackMode": "sequential",
          "submitLatencyThresholdMs": null,
          "maxBatchDecodeTokens": 1,
          "ringTokens": 1,
          "ringStop": 1,
          "ringStaging": 1,
          "disableCommandBatching": false
        }
      },
      "kernelPathPolicy": {
        "mode": "capability-aware",
        "sourceScope": ["manifest"],
        "allowSources": ["manifest"],
        "onIncompatible": "error"
      }
    }
  }
}
