{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doppler.local/schemas/model-release-platform.schema.json",
  "title": "Doppler model release platform strategy contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "id",
    "positioning",
    "architecture",
    "modelIR",
    "pack",
    "providers",
    "apiConvergence",
    "recovery",
    "commercialOffer",
    "referenceIntegrations",
    "promotionSequence",
    "compatibilityGraph",
    "dataCustody",
    "acquisitionBoundary",
    "claimBoundary",
    "adoptionGate",
    "networkAcceptance",
    "promotionSequenceScope",
    "standaloneAdoptionGate"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../src/config/schema/model-release-platform.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 5
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "const": "doppler-model-release-platform"
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "entryProduct",
        "recurringProduct",
        "initialIcp",
        "northStar",
        "promise",
        "buyer",
        "unitOfValue"
      ],
      "properties": {
        "category": {
          "type": "string",
          "const": "AI-native model release foundry for JavaScript and WebGPU"
        },
        "entryProduct": {
          "type": "string",
          "const": "Doppler Production Release"
        },
        "recurringProduct": {
          "type": "string",
          "const": "Doppler Release Operations"
        },
        "initialIcp": {
          "type": "string",
          "const": "Independent JavaScript/browser execution-network participants"
        },
        "northStar": {
          "type": "string",
          "const": "A reproducible open execution network delivers useful verified results and improves later assignments through admitted evidence; free adoption counts."
        },
        "promise": {
          "type": "string",
          "minLength": 1
        },
        "buyer": {
          "type": "string",
          "minLength": 1
        },
        "unitOfValue": {
          "type": "string",
          "const": "supported-model-release"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityPaths",
        "invariant",
        "forgeStages",
        "runtimeSteps",
        "runtimeForbidden"
      ],
      "properties": {
        "authorityPaths": {
          "$ref": "#/$defs/pathList"
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "forgeStages": {
          "$ref": "#/$defs/idList"
        },
        "runtimeSteps": {
          "$ref": "#/$defs/idList"
        },
        "runtimeForbidden": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "modelIR": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityPaths",
        "requirements"
      ],
      "properties": {
        "authorityPaths": {
          "$ref": "#/$defs/pathList"
        },
        "requirements": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityPaths",
        "authoritativeFor",
        "requiredReleaseElements"
      ],
      "properties": {
        "authorityPaths": {
          "$ref": "#/$defs/pathList"
        },
        "authoritativeFor": {
          "$ref": "#/$defs/idList"
        },
        "requiredReleaseElements": {
          "type": "array",
          "minItems": 12,
          "items": {
            "$ref": "#/$defs/trackedRequirement"
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionLaw",
        "runtimeMayInventPlan",
        "doeRequired",
        "targets"
      ],
      "properties": {
        "selectionLaw": {
          "type": "string",
          "const": "qualified-only"
        },
        "runtimeMayInventPlan": {
          "type": "boolean",
          "const": false
        },
        "doeRequired": {
          "type": "boolean",
          "const": false
        },
        "targets": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/provider"
          }
        }
      }
    },
    "apiConvergence": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/apiSurface"
      }
    },
    "recovery": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/trackedRequirement"
      }
    },
    "commercialOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "recurringProduct",
        "promise",
        "applicationClasses",
        "intake",
        "deliverables",
        "paidSurfaces",
        "promotionGate",
        "activationAuthority",
        "selfPromotionAllowed",
        "currentAssessment",
        "blockerCode",
        "requiredForTechnicalAcceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "doppler-production-release"
        },
        "name": {
          "type": "string",
          "const": "Doppler Production Release"
        },
        "recurringProduct": {
          "type": "string",
          "const": "Doppler Release Operations"
        },
        "promise": {
          "type": "string",
          "minLength": 1
        },
        "applicationClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "const": "electron-reranking"
          }
        },
        "intake": {
          "$ref": "#/$defs/stringList"
        },
        "deliverables": {
          "$ref": "#/$defs/stringList"
        },
        "paidSurfaces": {
          "$ref": "#/$defs/stringList"
        },
        "promotionGate": {
          "type": "string",
          "minLength": 1
        },
        "activationAuthority": {
          "type": "string",
          "const": "customer-controlled"
        },
        "selfPromotionAllowed": {
          "type": "boolean",
          "const": false
        },
        "currentAssessment": {
          "type": "string",
          "const": "unestablished"
        },
        "blockerCode": {
          "type": "string",
          "const": "paid-doppler-production-release-missing"
        },
        "requiredForTechnicalAcceptance": {
          "const": false
        }
      }
    },
    "referenceIntegrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "externalAdoptionEvidence",
        "commercialDemandEvidence",
        "integrations"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "const": "Internally controlled reference integrations proving application-integration mechanics."
        },
        "externalAdoptionEvidence": {
          "type": "boolean",
          "const": false
        },
        "commercialDemandEvidence": {
          "type": "boolean",
          "const": false
        },
        "integrations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "workload"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "workload": {
                "type": "string",
                "enum": [
                  "generation",
                  "embedding",
                  "reranking"
                ]
              }
            }
          }
        }
      }
    },
    "promotionSequence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "gate",
          "completionState",
          "evidencePaths",
          "blockerCode"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "id": {
            "$ref": "#/$defs/id"
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "completionState": {
            "type": "string",
            "enum": [
              "implemented",
              "external-evidence-required"
            ]
          },
          "evidencePaths": {
            "$ref": "#/$defs/pathList"
          },
          "blockerCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          }
        }
      }
    },
    "compatibilityGraph": {
      "$ref": "#/$defs/idList"
    },
    "dataCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultRule",
        "shareableClasses"
      ],
      "properties": {
        "defaultRule": {
          "type": "string",
          "minLength": 1
        },
        "shareableClasses": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "acquisitionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingObjective",
        "candidateBuyerClasses",
        "rule",
        "requiredForTechnicalAcceptance"
      ],
      "properties": {
        "operatingObjective": {
          "type": "string",
          "minLength": 1
        },
        "candidateBuyerClasses": {
          "$ref": "#/$defs/stringList"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "requiredForTechnicalAcceptance": {
          "const": false
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalStateAuthority",
        "forbiddenInferences"
      ],
      "properties": {
        "goalStateAuthority": {
          "$ref": "#/$defs/path"
        },
        "forbiddenInferences": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "adoptionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "requiredEvidence",
        "p2pRequired",
        "paymentRequired",
        "goalId"
      ],
      "properties": {
        "primary": {
          "const": true
        },
        "requiredEvidence": {
          "const": [
            "voluntary-independent-repeat-use",
            "useful-oracle-valid-results",
            "independent-machines-and-operator-provenance"
          ]
        },
        "p2pRequired": {
          "const": true
        },
        "paymentRequired": {
          "const": false
        },
        "goalId": {
          "const": "open-execution-network"
        }
      }
    },
    "networkAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalId",
        "firstModelId",
        "operation",
        "requiredEvidence",
        "paymentRequired",
        "doeRequired",
        "agentPackImprovementRequired",
        "electronCustomerRequired",
        "privateInputDefault",
        "redistribution",
        "delegation",
        "protocols"
      ],
      "properties": {
        "goalId": {
          "const": "open-execution-network"
        },
        "firstModelId": {
          "const": "esm2-t12-35m-ur50d-f32-af32"
        },
        "operation": {
          "const": "encodeSequence"
        },
        "requiredEvidence": {
          "const": [
            "actual-signed-esm2-pack-and-weights",
            "public-open-pack-encode-sequence",
            "local-execution-without-delegation",
            "explicit-complete-job-delegation",
            "authorized-optional-redistribution",
            "independent-machines-and-operator-provenance",
            "fresh-receiver-origin-and-mirrors-disabled",
            "multi-source-reconstruction",
            "corruption-rejection-and-participant-loss-recovery",
            "frozen-public-sequence-corpus-and-correctness-oracle",
            "assignment-bound-accepted-useful-results",
            "connected-pack-assignment-receipt-lineage",
            "admitted-history-before-held-out-jobs",
            "no-history-and-competent-frozen-scheduler-controls",
            "predeclared-benefit-with-uncertainty-and-unchanged-correctness",
            "all-attempt-resource-accounting",
            "revoked-stale-duplicate-insufficient-history-negatives",
            "private-inputs-local-by-default",
            "forkable-protocols-and-evidence-export",
            "voluntary-independent-repeat-use"
          ]
        },
        "paymentRequired": {
          "const": false
        },
        "doeRequired": {
          "const": false
        },
        "agentPackImprovementRequired": {
          "const": false
        },
        "electronCustomerRequired": {
          "const": false
        },
        "privateInputDefault": {
          "const": "local-only"
        },
        "redistribution": {
          "const": "explicit-opt-in"
        },
        "delegation": {
          "const": "explicit-complete-jobs"
        },
        "protocols": {
          "const": "forkable"
        }
      }
    },
    "promotionSequenceScope": {
      "const": "standalone-commercial"
    },
    "standaloneAdoptionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "requiredEvidence",
        "p2pRequired",
        "currentAssessment"
      ],
      "properties": {
        "primary": {
          "const": false
        },
        "p2pRequired": {
          "const": false
        },
        "currentAssessment": {
          "const": "unestablished"
        },
        "requiredEvidence": {
          "const": [
            "unrelated-maintainer-acceptance",
            "application-owned-outcome-improvement",
            "parity-qualified-incumbent-comparison",
            "customer-operated-devices",
            "rejected-candidate-and-recovery",
            "retained-use",
            "second-revision-less-release-effort"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "trackedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementationState",
        "evidencePaths",
        "blockerCode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "implementationState": {
          "type": "string",
          "enum": [
            "implemented",
            "partial"
          ]
        },
        "evidencePaths": {
          "$ref": "#/$defs/pathList"
        },
        "blockerCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "qualificationAuthority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "owned",
            "incumbent",
            "optional",
            "reference"
          ]
        },
        "qualificationAuthority": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "apiSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "evidencePaths",
        "blockerCode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "pack-authoritative",
            "compatibility-intake",
            "migration-required"
          ]
        },
        "evidencePaths": {
          "$ref": "#/$defs/pathList"
        },
        "blockerCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      }
    }
  }
}
