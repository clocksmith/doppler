{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/provider-conformance-capture-v2.schema.json",
  "title": "Doppler Provider Conformance Capture v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suiteId",
    "laneId",
    "qualifiedAtUtc",
    "expiresAtUtc",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "doppler.provider-conformance-capture/v2" },
    "suiteId": { "$ref": "#/$defs/id" },
    "laneId": { "$ref": "#/$defs/id" },
    "qualifiedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelContract",
        "resolutionIdentity",
        "operations",
        "lifecycle",
        "correctness",
        "providerReceipt"
      ],
      "properties": {
        "modelContract": { "$ref": "#/$defs/repoPath" },
        "resolutionIdentity": { "$ref": "#/$defs/repoPath" },
        "operations": { "$ref": "#/$defs/repoPath" },
        "lifecycle": { "$ref": "#/$defs/repoPath" },
        "correctness": { "$ref": "#/$defs/repoPath" },
        "providerReceipt": { "$ref": "#/$defs/repoPath" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lifecycleResult": { "enum": ["passed", "failed", "not-run"] },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    }
  }
}
