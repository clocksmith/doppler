{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doppler:model-ir-schema:v1",
  "title": "Doppler ModelIR v1",
  "description": "Fail-closed, hardware-independent model facts extracted from source artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "modelId", "architecture", "vocabSize", "hiddenSize",
    "numLayers", "sourceIdentity", "tensorRoles", "layers", "attentionGeometry",
    "normalization", "rope", "ffn", "outputTopology", "phases"
  ],
  "properties": {
    "schema": { "const": "doppler.model-ir/v1" },
    "schemaVersion": { "const": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "vocabSize": { "type": "integer", "minimum": 1 },
    "hiddenSize": { "type": "integer", "minimum": 1 },
    "numLayers": { "type": "integer", "minimum": 1 },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestArtifactId", "manifestHash"],
      "properties": {
        "manifestArtifactId": { "type": "string", "minLength": 1 },
        "manifestHash": { "$ref": "#/$defs/digest" }
      }
    },
    "tensorRoles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "shape", "semanticDtype"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "shape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "semanticDtype": { "type": "string", "minLength": 1 }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "type"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "minLength": 1 },
          "attention": { "type": "object" },
          "ffn": { "type": "object" },
          "norm": { "type": "object" }
        }
      }
    },
    "attentionGeometry": {
      "type": "object",
      "required": ["numHeads", "numKvHeads", "headDim"],
      "properties": {
        "numHeads": { "type": "integer", "minimum": 1 },
        "numKvHeads": { "type": "integer", "minimum": 1 },
        "headDim": { "type": "integer", "minimum": 1 },
        "slidingWindow": { "type": ["integer", "null"], "minimum": 1 },
        "qkNorm": { "type": "boolean" }
      }
    },
    "normalization": {
      "type": "object",
      "required": ["type", "eps"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "eps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rope": {
      "type": ["object", "null"],
      "properties": {
        "dimension": { "type": "integer", "minimum": 1 },
        "baseFreq": { "type": "number", "minimum": 1 },
        "scaling": { "type": ["object", "null"] }
      }
    },
    "ffn": {
      "type": "object",
      "required": ["type", "intermediateSize"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "intermediateSize": { "type": "integer", "minimum": 1 },
        "numExperts": { "type": ["integer", "null"], "minimum": 1 },
        "numExpertsPerToken": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "outputTopology": {
      "type": "object",
      "required": ["headType", "tieWeights"],
      "properties": {
        "headType": { "type": "string", "minLength": 1 },
        "tieWeights": { "type": "boolean" },
        "poolingMode": { "type": ["string", "null"] }
      }
    },
    "phases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
