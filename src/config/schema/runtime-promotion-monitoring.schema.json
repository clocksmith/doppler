{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/runtime-promotion-monitoring.schema.json",
  "title": "Doppler Runtime Promotion Monitoring",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "source", "requiredChangeClasses", "promotions"],
  "properties": {
    "$schema": { "const": "../../src/config/schema/runtime-promotion-monitoring.schema.json" },
    "schemaVersion": { "const": 2 },
    "source": { "const": "doppler" },
    "requiredChangeClasses": {
      "const": [
        "scheduling-allocation-cache",
        "numerical-kernel",
        "precision-quantization",
        "model-artifact",
        "adapter",
        "provider-integration"
      ]
    },
    "promotions": {
      "type": "array",
      "items": { "$ref": "#/$defs/promotion" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "nullableInstant": { "type": ["string", "null"], "format": "date-time" },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "artifactVariantId",
        "executionId",
        "providerId",
        "environmentFingerprint",
        "workloadId"
      ],
      "properties": {
        "modelId": { "$ref": "#/$defs/text" },
        "artifactVariantId": { "$ref": "#/$defs/digest" },
        "executionId": { "$ref": "#/$defs/digest" },
        "providerId": { "$ref": "#/$defs/text" },
        "environmentFingerprint": { "$ref": "#/$defs/text" },
        "workloadId": { "$ref": "#/$defs/text" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "baseline", "maxDegradationPercent"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "direction": { "enum": ["maximize", "minimize"] },
        "baseline": { "type": "number" },
        "maxDegradationPercent": { "type": "number", "minimum": 0 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "declaredAtUtc",
        "primaryMetric",
        "controlMetricIds",
        "neighborWorkloadIds",
        "minimumObservations",
        "revocationConditions"
      ],
      "properties": {
        "owner": { "$ref": "#/$defs/text" },
        "declaredAtUtc": { "type": "string", "format": "date-time" },
        "primaryMetric": { "$ref": "#/$defs/metric" },
        "controlMetricIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "neighborWorkloadIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "minimumObservations": { "type": "integer", "minimum": 2 },
        "revocationConditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decidedAtUtc",
        "reason",
        "revocationRecordId",
        "authority",
        "runtimeMutationApplied",
        "evidencePaths"
      ],
      "properties": {
        "status": { "enum": ["monitoring", "retain", "revoke"] },
        "decidedAtUtc": { "$ref": "#/$defs/nullableInstant" },
        "reason": { "$ref": "#/$defs/nullableText" },
        "revocationRecordId": { "$ref": "#/$defs/nullableText" },
        "authority": { "const": "human" },
        "runtimeMutationApplied": { "const": false },
        "evidencePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "optimizationReceiptPath",
        "optimizationReceiptHash",
        "candidateId",
        "candidateHash",
        "changeClass",
        "activatedAtUtc",
        "scope",
        "rollbackTarget",
        "plan",
        "observations",
        "decision"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "optimizationReceiptPath": { "$ref": "#/$defs/text" },
        "optimizationReceiptHash": { "$ref": "#/$defs/digest" },
        "candidateId": { "$ref": "#/$defs/text" },
        "candidateHash": { "$ref": "#/$defs/digest" },
        "changeClass": {
          "enum": [
            "scheduling-allocation-cache",
            "numerical-kernel",
            "precision-quantization",
            "model-artifact",
            "adapter",
            "provider-integration"
          ]
        },
        "activatedAtUtc": { "type": "string", "format": "date-time" },
        "scope": { "$ref": "#/$defs/scope" },
        "rollbackTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "digest", "knownSafe", "evidence"],
          "properties": {
            "kind": { "enum": ["runtime-profile", "kernel-variant", "execution-graph"] },
            "id": { "$ref": "#/$defs/text" },
            "digest": { "$ref": "#/$defs/digest" },
            "knownSafe": { "const": true },
            "evidence": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "plan": { "$ref": "#/$defs/plan" },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "decision": { "$ref": "#/$defs/decision" }
      }
    }
  }
}
