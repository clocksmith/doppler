{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/observation-policy-registry-v1.schema.json",
  "title": "Doppler observation policy registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "defaultPolicyId",
    "policies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "doppler.observation-policy-registry/v1"
    },
    "defaultPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "modifiesExecution",
        "performanceRepresentative",
        "requiredCaptures",
        "allowedClaimTypes",
        "gpuTimestampQueries",
        "perplexity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "modifiesExecution": {
          "type": "boolean"
        },
        "performanceRepresentative": {
          "type": "boolean"
        },
        "requiredCaptures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedClaimTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "execution-identity",
              "coarse-performance",
              "quality-inspection",
              "diagnostic"
            ]
          },
          "uniqueItems": true
        },
        "gpuTimestampQueries": {
          "type": "boolean"
        },
        "perplexity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/perplexity"
            }
          ]
        },
        "activationTrace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes",
            "maxFrameBytes",
            "maxFrames",
            "maxGridValues",
            "maxInFlight"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxFrameBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxFrames": {
              "type": "integer",
              "minimum": 1
            },
            "maxGridValues": {
              "type": "integer",
              "minimum": 1
            },
            "maxInFlight": {
              "type": "integer",
              "minimum": 1
            },
            "activityMaxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "activityMaxFrameValues": {
              "type": "integer",
              "minimum": 1
            },
            "activityMaxStateValues": {
              "type": "integer",
              "minimum": 1
            },
            "weightBlockValues": {
              "type": "integer",
              "minimum": 1
            },
            "weightReadValues": {
              "type": "integer",
              "minimum": 1
            },
            "weightRowGroupSize": {
              "type": "integer",
              "minimum": 1
            },
            "weightRawRows": {
              "type": "integer",
              "minimum": 1
            },
            "weightMaxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "activityTokenWindow": {
              "type": "integer",
              "minimum": 1
            },
            "activitySummaryBlock": {
              "type": "integer",
              "minimum": 1
            },
            "activitySelection": {
              "description": "Which activity captures are recorded. null in a field means no restriction; an empty list records none. A request may narrow this, never widen it.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roles",
                "layers",
                "tokens"
              ],
              "properties": {
                "roles": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "layers": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "tokens": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "to": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "activityRoleMaxBytes": {
              "description": "Byte budget for one capture kind, inside activityMaxBytes. A kind without an entry is limited only by activityMaxBytes.",
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "dependentRequired": {
            "activityMaxBytes": [
              "activitySelection",
              "activityRoleMaxBytes"
            ]
          }
        }
      }
    },
    "perplexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wordSegmentation",
        "aggregation",
        "rollingWindow"
      ],
      "properties": {
        "wordSegmentation": {
          "const": "doppler.word-segmentation/unicode-whitespace-v1"
        },
        "aggregation": {
          "const": "doppler.perplexity/summed-word-surprisal-v1"
        },
        "rollingWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "size"
          ],
          "properties": {
            "unit": {
              "enum": [
                "words",
                "tokens"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
