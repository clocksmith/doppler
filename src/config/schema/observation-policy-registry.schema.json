{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/observation-policy-registry-v1.schema.json",
  "title": "Doppler observation policy registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "defaultPolicyId",
    "policies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "doppler.observation-policy-registry/v1"
    },
    "defaultPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "modifiesExecution",
        "performanceRepresentative",
        "requiredCaptures",
        "allowedClaimTypes",
        "gpuTimestampQueries",
        "perplexity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "modifiesExecution": {
          "type": "boolean"
        },
        "performanceRepresentative": {
          "type": "boolean"
        },
        "requiredCaptures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedClaimTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "execution-identity",
              "coarse-performance",
              "quality-inspection",
              "diagnostic"
            ]
          },
          "uniqueItems": true
        },
        "gpuTimestampQueries": {
          "type": "boolean"
        },
        "perplexity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/perplexity"
            }
          ]
        }
      }
    },
    "perplexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wordSegmentation",
        "aggregation",
        "rollingWindow"
      ],
      "properties": {
        "wordSegmentation": {
          "const": "doppler.word-segmentation/unicode-whitespace-v1"
        },
        "aggregation": {
          "const": "doppler.perplexity/summed-word-surprisal-v1"
        },
        "rollingWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "size"
          ],
          "properties": {
            "unit": {
              "enum": [
                "words",
                "tokens"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
