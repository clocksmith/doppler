{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/catscan-policy-v1.schema.json",
  "title": "Doppler CATSCAN Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "source",
    "charterFilename",
    "indexPath",
    "maxWords",
    "requiredMetadata",
    "requiredSections",
    "freedomText",
    "ignoredDirectories",
    "requiredCharterPaths"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "doppler"
    },
    "charterFilename": {
      "const": "CATSCAN.md"
    },
    "indexPath": {
      "$ref": "#/$defs/repoRelativePath"
    },
    "maxWords": {
      "type": "integer",
      "minimum": 100,
      "maximum": 1000
    },
    "requiredMetadata": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["Component", "Parent"]
      },
      "allOf": [
        { "contains": { "const": "Component" } },
        { "contains": { "const": "Parent" } }
      ]
    },
    "requiredSections": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Target",
          "Authority",
          "Scope",
          "Contracts",
          "Invariants",
          "Acceptance",
          "Non-goals",
          "Freedom"
        ]
      }
    },
    "freedomText": {
      "type": "string",
      "minLength": 1
    },
    "ignoredDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+$"
      }
    },
    "requiredCharterPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/repoRelativePath" },
          { "pattern": "(^|/)CATSCAN\\.md$" }
        ]
      }
    }
  },
  "$defs": {
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    }
  }
}
