{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/runtime-optimization-receipt-v1.schema.json",
  "title": "Doppler runtime optimization receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractId",
    "contractHash",
    "candidateId",
    "candidateHash",
    "parentHash",
    "candidateKind",
    "registeredReference",
    "campaign",
    "model",
    "runtimeInputs",
    "verification",
    "measurement",
    "neighboringWorkloadGuards",
    "decision",
    "promotion",
    "receiptHash"
  ],
  "properties": {
    "schema": { "const": "doppler.runtime-optimization-receipt/v1" },
    "contractId": { "type": "string", "minLength": 1 },
    "contractHash": { "$ref": "#/$defs/digest" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateHash": { "$ref": "#/$defs/digest" },
    "parentHash": { "$ref": "#/$defs/digest" },
    "candidateKind": {
      "enum": [
        "runtime-profile",
        "registered-kernel-variant",
        "registered-execution-graph-patch"
      ]
    },
    "registeredReference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registryId", "digest"],
          "properties": {
            "registryId": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        { "type": "null" }
      ]
    },
    "campaign": { "$ref": "#/$defs/campaign" },
    "model": { "type": "object" },
    "runtimeInputs": { "type": "object" },
    "verification": { "type": "object" },
    "measurement": { "type": "object" },
    "neighboringWorkloadGuards": {
      "type": ["object", "null"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "status", "reasons"],
      "properties": {
        "accepted": { "type": "boolean" },
        "status": { "enum": ["accepted", "rejected", "invalid"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "recommended",
        "runtimeMutationApplied",
        "requiredStages",
        "revocationConditions"
      ],
      "properties": {
        "authority": { "const": "human" },
        "recommended": { "type": "boolean" },
        "runtimeMutationApplied": { "const": false },
        "requiredStages": {
          "const": ["shadow", "canary"]
        },
        "revocationConditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receiptHash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "changeClass",
        "causalHypothesis",
        "expectedMetric",
        "controlMetric",
        "endToEndAcceptanceMetric",
        "budgets",
        "stoppingRule",
        "retryConditions",
        "revocationConditions"
      ],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "changeClass": {
          "enum": [
            "scheduling-allocation-cache",
            "numerical-kernel",
            "precision-quantization",
            "model-artifact",
            "adapter",
            "provider-integration"
          ]
        },
        "causalHypothesis": { "type": "string", "minLength": 1 },
        "expectedMetric": { "type": "object" },
        "controlMetric": { "type": "object" },
        "endToEndAcceptanceMetric": { "type": "object" },
        "budgets": { "type": "object" },
        "stoppingRule": { "type": "object" },
        "retryConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "revocationConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
