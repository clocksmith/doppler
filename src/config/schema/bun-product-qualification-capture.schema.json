{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/bun-product-qualification-capture-v1.schema.json",
  "title": "Doppler Bun Product Qualification Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "qualificationId", "qualifiedAtUtc", "expiresAtUtc", "evidence"],
  "properties": {
    "schema": { "const": "doppler.bun-product-qualification-capture/v1" },
    "qualificationId": { "$ref": "#/$defs/id" },
    "qualifiedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "surfaceConformance",
        "lifecycle",
        "correctnessQuality",
        "reliability",
        "memory",
        "coldWarmResponse",
        "incumbentControl",
        "upgradeRequalification",
        "rollbackRevocation"
      ],
      "properties": {
        "execution": { "$ref": "#/$defs/repoPath" },
        "surfaceConformance": { "$ref": "#/$defs/repoPath" },
        "lifecycle": { "$ref": "#/$defs/repoPath" },
        "correctnessQuality": { "$ref": "#/$defs/repoPath" },
        "reliability": { "$ref": "#/$defs/repoPath" },
        "memory": { "$ref": "#/$defs/repoPath" },
        "coldWarmResponse": { "$ref": "#/$defs/repoPath" },
        "incumbentControl": { "$ref": "#/$defs/repoPath" },
        "upgradeRequalification": { "$ref": "#/$defs/repoPath" },
        "rollbackRevocation": { "$ref": "#/$defs/repoPath" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    }
  }
}
