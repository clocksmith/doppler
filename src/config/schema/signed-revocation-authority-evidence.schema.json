{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/signed-revocation-authority-evidence-v1.schema.json",
  "title": "Doppler Signed Revocation Authority Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceClass",
    "qualificationId",
    "owner",
    "authorityId",
    "harnessRevision",
    "environmentFingerprint",
    "capturedAtUtc",
    "result",
    "observations"
  ],
  "properties": {
    "schema": { "const": "doppler.signed-revocation-authority-evidence/v1" },
    "evidenceClass": {
      "enum": [
        "endpointDeployment",
        "packageTrustBinding",
        "onlineKeyCustody",
        "recoveryKeyCustody",
        "custodySeparation",
        "browserDurableState",
        "nodeDurableState",
        "refreshCurrent",
        "onlineKeyRotation",
        "exactReplay",
        "rewrittenReplayRejection",
        "sequenceRollbackRejection",
        "epochRollbackRejection",
        "offlineExpiry",
        "compromiseRecovery",
        "durableStoreRestart",
        "loadedIdentityInvalidation",
        "applicationFailClosed",
        "requalification"
      ]
    },
    "qualificationId": { "$ref": "#/$defs/text" },
    "owner": { "$ref": "#/$defs/text" },
    "authorityId": { "$ref": "#/$defs/text" },
    "harnessRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environmentFingerprint": { "$ref": "#/$defs/digest" },
    "capturedAtUtc": { "type": "string", "format": "date-time" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": { "passed": { "type": "boolean" } }
    },
    "observations": { "type": "object" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
