{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/bun-product-qualification-evidence-v1.schema.json",
  "title": "Doppler Bun Product Qualification Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceClass",
    "qualificationId",
    "workload",
    "logicalModelId",
    "manifestVariantId",
    "resolvedArtifactVariantId",
    "resolvedExecutionId",
    "bunVersion",
    "webgpuImplementationId",
    "providerId",
    "harnessRevision",
    "environmentFingerprint",
    "capturedAtUtc",
    "result",
    "observations"
  ],
  "properties": {
    "schema": { "const": "doppler.bun-product-qualification-evidence/v1" },
    "evidenceClass": {
      "enum": [
        "surfaceConformance",
        "lifecycle",
        "correctnessQuality",
        "reliability",
        "memory",
        "coldWarmResponse",
        "incumbentControl",
        "upgradeRequalification",
        "rollbackRevocation"
      ]
    },
    "qualificationId": { "$ref": "#/$defs/id" },
    "workload": { "enum": ["generation", "embedding", "reranking"] },
    "logicalModelId": { "type": "string", "minLength": 1 },
    "manifestVariantId": { "type": "string", "minLength": 1 },
    "resolvedArtifactVariantId": { "$ref": "#/$defs/sha256" },
    "resolvedExecutionId": { "$ref": "#/$defs/sha256" },
    "bunVersion": { "type": "string", "minLength": 1 },
    "webgpuImplementationId": { "type": "string", "minLength": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "harnessRevision": { "$ref": "#/$defs/revision" },
    "environmentFingerprint": { "$ref": "#/$defs/sha256" },
    "capturedAtUtc": { "type": "string", "format": "date-time" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": { "passed": { "type": "boolean" } }
    },
    "observations": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
