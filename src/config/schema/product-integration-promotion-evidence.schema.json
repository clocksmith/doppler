{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/product-integration-promotion-evidence-v1.schema.json",
  "title": "Doppler Product Integration Promotion Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "integrationId",
    "applicationName",
    "workload",
    "owner",
    "logicalModelId",
    "resolvedArtifactVariantId",
    "resolvedExecutionId",
    "applicationRevision",
    "harnessRevision",
    "environmentFingerprint",
    "evidenceSetDigest",
    "decision",
    "authority",
    "reviewer",
    "reviewerRevision",
    "rationale",
    "promotedAtUtc",
    "qualifiedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schema": { "const": "doppler.product-integration-promotion-evidence/v1" },
    "integrationId": { "$ref": "#/$defs/id" },
    "applicationName": { "type": "string", "minLength": 1 },
    "workload": { "enum": ["generation", "embedding-retrieval", "reranking"] },
    "owner": { "type": "string", "minLength": 1 },
    "logicalModelId": { "type": "string", "minLength": 1 },
    "resolvedArtifactVariantId": { "$ref": "#/$defs/sha256" },
    "resolvedExecutionId": { "$ref": "#/$defs/sha256" },
    "applicationRevision": { "$ref": "#/$defs/revision" },
    "harnessRevision": { "$ref": "#/$defs/revision" },
    "environmentFingerprint": { "$ref": "#/$defs/sha256" },
    "evidenceSetDigest": { "$ref": "#/$defs/sha256" },
    "decision": { "const": "promote-product-supported" },
    "authority": { "const": "human" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewerRevision": { "$ref": "#/$defs/revision" },
    "rationale": { "type": "string", "minLength": 1 },
    "promotedAtUtc": { "type": "string", "format": "date-time" },
    "qualifiedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
