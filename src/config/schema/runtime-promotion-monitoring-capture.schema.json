{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/runtime-promotion-monitoring-capture-v1.schema.json",
  "title": "Doppler Runtime Promotion Monitoring Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotionId",
    "optimizationReceiptPath",
    "activationEvidencePath",
    "rollbackTarget",
    "plan",
    "observationPaths",
    "decisionEvidencePath"
  ],
  "properties": {
    "schema": { "const": "doppler.runtime-promotion-monitoring-capture/v1" },
    "promotionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "optimizationReceiptPath": { "$ref": "#/$defs/repoPath" },
    "activationEvidencePath": { "$ref": "#/$defs/repoPath" },
    "rollbackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest", "evidencePath"],
      "properties": {
        "kind": { "enum": ["runtime-profile", "kernel-variant", "execution-graph"] },
        "id": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" },
        "evidencePath": { "$ref": "#/$defs/repoPath" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "declaredAtUtc",
        "primaryMetric",
        "controlMetricIds",
        "neighborWorkloadIds",
        "minimumObservations"
      ],
      "properties": {
        "owner": { "$ref": "#/$defs/text" },
        "declaredAtUtc": { "type": "string", "format": "date-time" },
        "primaryMetric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "direction", "baseline", "maxDegradationPercent"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "direction": { "enum": ["maximize", "minimize"] },
            "baseline": { "type": "number" },
            "maxDegradationPercent": { "type": "number", "minimum": 0 }
          }
        },
        "controlMetricIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "neighborWorkloadIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "minimumObservations": { "type": "integer", "minimum": 2 }
      }
    },
    "observationPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "decisionEvidencePath": {
      "anyOf": [
        { "$ref": "#/$defs/repoPath" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    }
  }
}
