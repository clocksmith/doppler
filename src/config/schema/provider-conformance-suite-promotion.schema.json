{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clocksmith.dev/doppler/schemas/provider-conformance-suite-promotion-v1.schema.json",
  "title": "Doppler Provider Conformance Suite Promotion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suiteId",
    "workload",
    "logicalModelId",
    "resolvedArtifactVariantId",
    "requiredProviderLaneIds",
    "providerSetDigest",
    "decision",
    "authority",
    "reviewer",
    "rationale",
    "promotedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schema": { "const": "doppler.provider-conformance-suite-promotion/v1" },
    "suiteId": { "$ref": "#/$defs/id" },
    "workload": { "enum": ["generation", "embedding", "reranking"] },
    "logicalModelId": { "type": "string", "minLength": 1 },
    "resolvedArtifactVariantId": { "$ref": "#/$defs/sha256" },
    "requiredProviderLaneIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "providerSetDigest": { "$ref": "#/$defs/sha256" },
    "decision": { "const": "promote" },
    "authority": { "const": "human" },
    "reviewer": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "promotedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
