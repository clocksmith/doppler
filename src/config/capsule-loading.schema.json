{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsule acquisition limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "loadTimeoutMs": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647, "default": null },
    "maxMetadataBytes": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 16777216 },
    "maxRetainedArtifactBytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "maxAcquisitionChunkBytes": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576 },
    "verificationYieldBytes": { "type": "integer", "minimum": 65536, "maximum": 16777216, "default": 1048576 }
  },
  "required": ["loadTimeoutMs", "maxMetadataBytes", "maxRetainedArtifactBytes", "maxAcquisitionChunkBytes", "verificationYieldBytes"]
}
