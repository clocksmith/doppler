{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsule acquisition limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "loadTimeoutMs": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647, "default": null },
    "maxMetadataBytes": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 16777216 }
  },
  "required": ["loadTimeoutMs", "maxMetadataBytes"]
}
