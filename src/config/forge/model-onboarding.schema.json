{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doppler.model-onboarding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceSpec", "vocabulary", "entryPointIds", "lineage"],
  "properties": {
    "schema": { "const": "doppler.model-onboarding/v1" },
    "sourceSpec": { "$ref": "#/$defs/input" },
    "vocabulary": { "$ref": "#/$defs/input" },
    "entryPointIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "lineage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["recipe", "template"],
          "properties": { "recipe": { "$ref": "#/$defs/input" }, "template": { "$ref": "#/$defs/input" } }
        }
      ]
    }
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
