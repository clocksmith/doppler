{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maintainer-approved model-family engineering scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "authority", "maintainerId", "purpose", "sourceRepository", "sourceRevision", "conversionConfigs", "referenceTest", "licenseEvidence", "publicationAllowed"],
  "properties": {
    "schema": { "const": "doppler.model-family-authorization/v2" },
    "family": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "authority": { "const": "maintainer" },
    "maintainerId": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "sourceRepository": { "type": "string", "pattern": "^https://" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "conversionConfigs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
    "referenceTest": { "$ref": "#/$defs/input" },
    "licenseEvidence": { "$ref": "#/$defs/input" },
    "publicationAllowed": { "const": false }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
